# Auto-detect text files and perform LF normalization
* text=auto

# Mark lockfiles and build outputs as generated/vendored
# Prevents them from inflating contributor stats and diff metrics on GitHub
package-lock.json linguist-generated=true linguist-vendored=true
*/package-lock.json linguist-generated=true linguist-vendored=true
*.lock linguist-generated=true linguist-vendored=true

# Mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary

