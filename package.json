{
  "name": "vidya",
  "version": "1.0.0",
  "private": true,
  "description": "A Media Server for Video Lectures",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run --passWithNoTests",
    "test:backend": "node -e \"console.log('No backend tests configured yet')\"",
    "test:watch": "vitest",
    "server": "npm start -w backend",
    "dev": "concurrently \"npm run dev-server\" \"npm run start\"",
    "dev-server": "npm run dev -w backend"
  },
  "author": {
    "name": "DEXTIFY",
    "url": "https://dextify.org"
  },
  "license": "GNU General Public License v3.0",
  "dependencies": {
    "axios": "^1.7.7",
    "framer-motion": "^11.11.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-parallax-tilt": "^1.7.245",
    "react-router-dom": "^7.18.5",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "jsdom": "^25.0.1",
    "nodemon": "^1.0.2",
    "supertest": "^7.2.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true,
    "sqlite3@6.0.1": true,
    "nodemon@1.19.4": true
  }
}
