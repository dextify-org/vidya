{
  "name": "vidya",
  "version": "1.0.0",
  "private": true,
  "description": "A Media Server for Video Lectures",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run",
    "test:backend": "node --test backend/tests/*.test.js",
    "test:watch": "vitest",
    "server": "npm start -w backend",
    "dev": "concurrently \"npm run dev-server\" \"npm run start\"",
    "dev-server": "npm run dev -w backend"
  },
  "author": {
    "name": "DEXTIFY",
    "url": "https://dextify.org"
  },
  "license": "GNU General Public License v3.0",
  "dependencies": {
    "axios": "^1.19.0",
    "framer-motion": "^11.11.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1",
    "react-parallax-tilt": "^1.7.245",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.2",
    "jsdom": "^28.0.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
